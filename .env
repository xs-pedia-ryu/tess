# ==============================
# GoBiz authentication
# ==============================
# Recommended for automated server deployment: email + password.
GOPAY_LOGIN_METHOD=password
GOPAY_EMAIL=alfatharraby5@gmail.com
GOPAY_PASSWORD=Alfath123@

# Alternative: OTP login. This needs a server-side OTP callback for non-interactive hosting.
# GOPAY_LOGIN_METHOD=otp
# GOPAY_PHONE=082310906429

# Static QRIS string from your merchant QRIS.
QRIS_STRING=00020101021126610014COM.GO-JEK.WWW01189360091430973426920210G0973426920303UMI51440014ID.CO.QRIS.WWW0215ID10265700401900303UMI5204581653033605802ID5925XS-PEDIA GATEAWAY, Gaming6009TANGERANG61051512362140703A01110362163040C6E


# Default order amount used by the demo UI.
PRICE_AMOUNT=10

# Optional: interval for the Railway background watcher.
WATCHER_INTERVAL_MS=6000

# Payment session lifetime.
PAYMENT_TIMEOUT_MS=600000

# Storage directory. On Railway, mount a persistent Volume to /app/data and keep this default.
DATA_DIR=./data

PAYMENT_SIGNING_SECRET=xiao-qris-gateway-secret-2026-acak

# Optional server-to-server key for your second web application.
# Send it as: x-api-key: <value>
API_KEY=change-me

# Comma-separated browser origins allowed to call this API.
# Example: https://web-kedua.vercel.app,https://domain-kamu.com
# Empty means same-origin / permissive development mode.
ALLOWED_ORIGINS=https://xs-pedia.my.id

PORT=3000

# API key for the /api/v1 server-to-server endpoints
API_KEY=xspedia

# Persistence/cache directory. On Railway, mount a Volume at /app/data and set this to /app/data.
DATA_DIR=./data
GOPAY_CACHE_FILE=./data/.gopay_cache.json
PAYMENT_STORE_FILE=./data/payments.json

# Optional
WATCHER_INTERVAL_MS=5000
ALLOWED_ORIGINS=
PORT=3000

# Secret stabil untuk verifikasi status/cancel lintas instance (wajib untuk produksi di Vercel)
PAYMENT_SIGNING_SECRET=ganti_dengan_secret_acak_panjang

